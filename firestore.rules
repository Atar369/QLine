rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activePartner(restaurantId) {
      return exists(/databases/$(database)/documents/partnerRestaurants/$(restaurantId))
        && get(/databases/$(database)/documents/partnerRestaurants/$(restaurantId)).data.active == true;
    }

    function staffFor(restaurantId) {
      return signedIn()
        && activePartner(restaurantId)
        && exists(/databases/$(database)/documents/staffMemberships/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffMemberships/$(request.auth.uid))
          .data.restaurantIds.hasAny([restaurantId]);
    }

    function priorWaitingNumbers() {
      return resource.data.get('waitingNumbers', []);
    }

    function validQueueJoin(restaurantId) {
      let prior = priorWaitingNumbers();
      let ticketPath = /databases/$(database)/documents/tickets/$(restaurantId + '_' + request.auth.uid);
      let ticket = getAfter(ticketPath);
      return signedIn()
        && activePartner(restaurantId)
        && existsAfter(ticketPath)
        && ticket.data.userId == request.auth.uid
        && ticket.data.queueId == restaurantId
        && ticket.data.number == resource.data.nextTicketNumber
        && ticket.data.status == 'WAITING'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nextTicketNumber', 'waitingNumbers'])
        && resource.data.isOpen == true
        && request.resource.data.nextTicketNumber == resource.data.nextTicketNumber + 1
        && request.resource.data.waitingNumbers.size() == prior.size() + 1
        && request.resource.data.waitingNumbers.hasAll(prior)
        && !prior.hasAny([resource.data.nextTicketNumber])
        && request.resource.data.waitingNumbers.hasAny([resource.data.nextTicketNumber]);
    }

    function validInitialQueueJoin(restaurantId) {
      let ticketPath = /databases/$(database)/documents/tickets/$(restaurantId + '_' + request.auth.uid);
      let ticket = getAfter(ticketPath);
      return signedIn()
        && activePartner(restaurantId)
        && existsAfter(ticketPath)
        && ticket.data.userId == request.auth.uid
        && ticket.data.queueId == restaurantId
        && ticket.data.number == 1
        && ticket.data.status == 'WAITING'
        && request.resource.data.keys().hasOnly([
          'name', 'currentTicketNumber', 'nextTicketNumber', 'minutesPerPerson', 'isOpen', 'waitingNumbers'
        ])
        && request.resource.data.name is string
        && request.resource.data.minutesPerPerson is int
        && request.resource.data.minutesPerPerson >= 1
        && request.resource.data.minutesPerPerson <= 60
        && request.resource.data.currentTicketNumber == 0
        && request.resource.data.nextTicketNumber == 2
        && request.resource.data.waitingNumbers == [1]
        && request.resource.data.isOpen == true;
    }

    function validQueueCancellation(restaurantId) {
      let ticketPath = /databases/$(database)/documents/tickets/$(restaurantId + '_' + request.auth.uid);
      let ticket = get(ticketPath);
      let updatedTicket = getAfter(ticketPath);
      let prior = priorWaitingNumbers();
      return signedIn()
        && exists(ticketPath)
        && ticket.data.status == 'WAITING'
        && updatedTicket.data.status == 'CANCELLED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waitingNumbers'])
        && request.resource.data.waitingNumbers.size() == prior.size() - 1
        && prior.hasAll(request.resource.data.waitingNumbers)
        && prior.hasAny([ticket.data.number])
        && !request.resource.data.waitingNumbers.hasAny([ticket.data.number]);
    }

    match /staffMemberships/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /partnerRestaurants/{restaurantId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /queues/{restaurantId} {
      allow read: if signedIn();
      allow create: if staffFor(restaurantId) || validInitialQueueJoin(restaurantId);
      allow update: if staffFor(restaurantId)
        || validQueueJoin(restaurantId)
        || validQueueCancellation(restaurantId);
      allow delete: if false;
    }

    match /tickets/{ticketId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || staffFor(resource.data.queueId));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['queueId', 'number', 'userId', 'status'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.queueId is string
        && request.resource.data.number is int
        && activePartner(request.resource.data.queueId)
        && request.resource.data.status == 'WAITING'
        && ticketId == request.resource.data.queueId + '_' + request.auth.uid
        && existsAfter(/databases/$(database)/documents/queues/$(request.resource.data.queueId))
        && getAfter(/databases/$(database)/documents/queues/$(request.resource.data.queueId))
          .data.nextTicketNumber == request.resource.data.number + 1
        && getAfter(/databases/$(database)/documents/queues/$(request.resource.data.queueId))
          .data.waitingNumbers.hasAny([request.resource.data.number]);
      allow update: if (staffFor(resource.data.queueId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'WAITING'
          && request.resource.data.status == 'CANCELLED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status in ['DONE', 'CANCELLED']
          && request.resource.data.status == 'WAITING'
          && activePartner(resource.data.queueId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['number', 'status'])
          && getAfter(/databases/$(database)/documents/queues/$(resource.data.queueId))
            .data.nextTicketNumber == request.resource.data.number + 1
          && getAfter(/databases/$(database)/documents/queues/$(resource.data.queueId))
            .data.waitingNumbers.hasAny([request.resource.data.number]));
      allow delete: if false;
    }

    match /queueReports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'restaurantId', 'userId', 'storagePath', 'estimatedPeople', 'waitMinutes', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.restaurantId is string
        && request.resource.data.storagePath
          == 'queue-reports/' + request.resource.data.restaurantId + '/' + request.auth.uid + '/' + reportId
        && request.resource.data.createdAt == request.time
        && (request.resource.data.estimatedPeople == null
          || (request.resource.data.estimatedPeople is int
            && request.resource.data.estimatedPeople >= 0
            && request.resource.data.estimatedPeople <= 10000))
        && (request.resource.data.waitMinutes == null
          || (request.resource.data.waitMinutes is int
            && request.resource.data.waitMinutes >= 0
            && request.resource.data.waitMinutes <= 10000));
      allow update, delete: if false;
    }
  }
}
